# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Both of these are safe to be public: the anon key
# is designed to be exposed in the browser, and Row Level Security is what
# actually protects the data.
#
# NEVER put the service_role key in this file, in .env.local, or in any
# NEXT_PUBLIC_* variable. It bypasses RLS entirely. See PROJECT.md § Security.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
